FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    dnsmasq-base \
    tini \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Configuration and leases live in the /data volume (./dhcp on the Mac).
# --user=root: dnsmasq must not drop privileges, otherwise it cannot write
# the lease file in the mounted volume.
ENTRYPOINT ["/usr/bin/tini", "--", "dnsmasq", \
    "--keep-in-foreground", \
    "--log-facility=-", \
    "--user=root", \
    "--conf-file=/data/dnsmasq.conf", \
    "--dhcp-leasefile=/data/dnsmasq.leases"]
