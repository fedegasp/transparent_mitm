#!/bin/bash
set -euo pipefail

# Management of mitmproxy (container mitmproxy.test), of the LAN DHCP/DNS
# (container mitm-dhcp), and of the pf rules that forward traffic to them.
#
# No sudo: the pf rules are applied by the root LaunchDaemon com.mitm.pf,
# to which this command writes the container IPs in /usr/local/var/mitm-pf/.
# DHCP is standalone (start dhcp / stop dhcp do not touch mitmproxy): with
# DHCP only, clients have the Mac as gateway and browse via NAT, without
# interception. mitmproxy depends on DHCP: start brings it up first.

usage() {
  cat <<'EOF'
Usage: ./mitm <command>

  start [dhcp]            start DHCP and mitmproxy (with dhcp: DHCP only)
  stop [dhcp|all] [--rm]  stop mitmproxy (dhcp: DHCP only; all: both)
                          --rm also removes the containers (after build, or to
                          change MITM_UI / MITM_WEB_PASSWORD)
  status                  status of containers, pf rules, daemon and agents
  open                    open the mitmproxy interface: web UI in the browser,
                          or the console as with attach
  attach                  mitmproxy console (tmux; Ctrl-b d to detach)
  mock                    mock dashboard in the browser (also M in the console)
  logs [dhcp|pf] [-f]     logs of mitmproxy, dnsmasq or the pf daemon
  build [proxy|dhcp]      build the images (default: both)
  install                 installation (one-off; rerun after changing
                          mitm.conf or the daemon)
  uninstall               remove agents, daemon and pf rules

mitmproxy interface, read only when the container is created:
  MITM_UI=console (default)          mitmproxy in tmux: ./mitm open (or attach)
  MITM_UI=web MITM_WEB_PASSWORD=...  mitmweb on http://mitmproxy.test:8081: ./mitm open

Console, read at every open/attach:
  MITM_EDITOR="<application>"        Mac application for editing (e), e.g.
                                     "Visual Studio Code" (default: the
                                     system's default text editor)
EOF
}

# Volumes use paths relative to the project directory (even when the
# command is run through a symbolic link)
cd "$(dirname "$(readlink -f "$0")")"

# Local DNS domain of container (created once with
# `sudo container system dns create test`). The built-in DNS only resolves
# containers named <name>.<domain>: on the Mac the web UI is reachable
# as http://mitmproxy.test:8081, whatever the current IP.
DNS_DOMAIN=test
PROXY=mitmproxy.$DNS_DOMAIN
PROXY_IMAGE=mitm-transparent
DHCP=mitm-dhcp
DHCP_IMAGE=mitm-dhcp
# Mock dashboard (mockui/server.py in the container): same name, another
# port. Plain HTTP: see HISTORY, item 19
MOCK_PORT=8082
MOCK_URL="http://$PROXY:$MOCK_PORT/"
STATE=/usr/local/var/mitm-pf
ANCHORS=/etc/pf.anchors
DAEMON_CONF=/usr/local/etc/mitm.conf
PF_LOG=/var/log/mitm-pf.log
IP_RE='^([0-9]{1,3}\.){3}[0-9]{1,3}$'

die() {
  echo "$*" >&2
  exit 1
}

# Value of KEY=value in mitm.conf, or in file $2 (like the daemon: the file
# is never executed)
conf() {
  sed -nE "s/^$1=[\"']?([^\"'#[:space:]]*).*/\1/p" "${2:-mitm.conf}" 2> /dev/null | tail -n 1
}

# Reads and validates mitm.conf: MAC_IP, PREFIX, ROUTER_IP, DHCP_FIRST,
# DHCP_LAST, DHCP_LEASE
load_conf() {
  local lan_ip v
  [ -f mitm.conf ] || die "mitm.conf missing"
  lan_ip=$(conf LAN_IP)
  MAC_IP=${lan_ip%/*}
  PREFIX=${lan_ip#*/}
  ROUTER_IP=$(conf ROUTER_IP)
  DHCP_FIRST=$(conf DHCP_FIRST)
  DHCP_LAST=$(conf DHCP_LAST)
  DHCP_LEASE=$(conf DHCP_LEASE)
  for v in MAC_IP ROUTER_IP DHCP_FIRST DHCP_LAST; do
    [[ ${!v} =~ $IP_RE ]] || die "mitm.conf: invalid value for $v: '${!v}'"
  done
  [[ $lan_ip == */* && $PREFIX =~ ^[0-9]+$ ]] && [ "$PREFIX" -ge 8 ] && [ "$PREFIX" -le 30 ] ||
    die "mitm.conf: LAN_IP must have a prefix (e.g. 192.168.3.2/24)"
  [[ $DHCP_LEASE =~ ^[0-9]+[mhd]?$ ]] || die "mitm.conf: invalid DHCP_LEASE: '$DHCP_LEASE'"
}

# The daemon's copy has the same values the daemon uses (comments may
# differ)
daemon_conf_current() {
  local key
  for key in LAN_IP ROUTER_IP; do
    [ "$(conf $key)" = "$(conf $key "$DAEMON_CONF")" ] || return 1
  done
}

# Container state: running, stopped, ... or absent
container_state() {
  container inspect "$1" 2> /dev/null | jq -r '.[0].status.state // "absent"' 2> /dev/null ||
    echo absent
}

# Container IP. It is assigned shortly after start: waits up to ~10s.
container_ip() {
  local ip
  for _ in $(seq 1 20); do
    ip=$(container inspect "$1" | jq -r '.[0].status.networks[0].ipv4Address // empty' | cut -d'/' -f1)
    if [ -n "$ip" ]; then
      echo "$ip"
      return 0
    fi
    sleep 0.5
  done
  die "Cannot determine the IP of container $1"
}

# Builds image $1 from directory $2 if it does not exist
ensure_image() {
  container image inspect "$1" > /dev/null 2>&1 && return 0
  echo "Image $1 missing, building it"
  container build -t "$1" "$2"
}

# Starts container $1 if stopped; returns 1 if it does not exist (to be
# created). A start error (e.g. volume on a path that no longer exists)
# ends the command: recreating it would fail anyway (name already in use).
start_existing() {
  case "$(container_state "$1")" in
    absent) return 1 ;;
    running) ;;
    *)
      echo "Starting container $1"
      container start "$1" > /dev/null ||
        die "Starting $1 failed: if the project was moved, recreate it with ./mitm stop all --rm"
      ;;
  esac
}

# Stops container $1 if running; with $2 = true also removes it
stop_container() {
  local state
  state=$(container_state "$1")
  if [ "$state" = absent ]; then
    echo "Container $1 not present"
    return 0
  fi
  if [ "$state" = running ]; then
    echo "Stopping container $1"
    container stop "$1" > /dev/null
  fi
  if [ "$2" = true ]; then
    echo "Removing container $1"
    container rm "$1" > /dev/null
  fi
}

# Writes the state file for the daemon (atomic rename: the daemon, triggered
# by WatchPaths on the directory, never reads a half-written file)
write_state() {
  [ -d "$STATE" ] || die "$STATE missing: install with ./mitm install"
  printf '%s\n' "$2" > "$STATE/.$1.tmp"
  mv "$STATE/.$1.tmp" "$STATE/$1"
}

# Waits for the daemon to apply the rule: anchor containing $2, or empty if
# $2 is empty. Up to ~10s.
wait_anchor() {
  for _ in $(seq 1 20); do
    if [ -z "$2" ]; then
      [ ! -s "$1" ] && return 0
    else
      grep -qF -- "$2" "$1" 2> /dev/null && return 0
    fi
    sleep 0.5
  done
  die "The com.mitm.pf daemon did not update $1: see $PF_LOG"
}

# mitmproxy interface the container was created with
proxy_ui() {
  if container inspect "$PROXY" 2> /dev/null |
    jq -e '.[0].configuration.initProcess.environment | index("MITM_UI=web")' > /dev/null; then
    echo web
  else
    echo console
  fi
}

# --- DHCP and DNS (dnsmasq) -------------------------------------------------

# Starts dnsmasq and the pf rules that forward to it the router's DHCP relay
# and the clients' DNS queries to the Mac. The LAN parameters come from
# mitm.conf: generates dhcp/lan.conf and restarts the container if it changed.
start_dhcp() {
  local mac_ip prefix router first last lease mask netmask lan_conf changed=false ip

  load_conf
  mac_ip=$MAC_IP prefix=$PREFIX router=$ROUTER_IP first=$DHCP_FIRST last=$DHCP_LAST lease=$DHCP_LEASE

  # The daemon uses its own copy of mitm.conf
  daemon_conf_current ||
    echo "Warning: mitm.conf differs from the daemon's copy, rerun: ./mitm install" >&2

  # LAN parameters for dnsmasq (included by dhcp/dnsmasq.conf)
  mask=$(((0xffffffff << (32 - prefix)) & 0xffffffff))
  netmask="$((mask >> 24 & 255)).$((mask >> 16 & 255)).$((mask >> 8 & 255)).$((mask & 255))"
  lan_conf="# Generated by ./mitm start dhcp from mitm.conf: do not edit
dhcp-range=$first,$last,$netmask,$lease
dhcp-option=option:router,$mac_ip
dhcp-option=option:dns-server,$mac_ip
dhcp-proxy=$router"
  if [ "$(cat dhcp/lan.conf 2> /dev/null)" != "$lan_conf" ]; then
    printf '%s\n' "$lan_conf" > dhcp/lan.conf
    changed=true
  fi

  # Creates the container if it does not exist, starts it if stopped.
  # Configuration and leases in ./dhcp. dnsmasq requires NET_ADMIN for DHCP
  # (otherwise it exits at startup).
  if start_existing "$DHCP"; then
    # dnsmasq reads its configuration only at startup
    if [ "$changed" = true ]; then
      echo "LAN configuration changed, restarting container $DHCP"
      container stop "$DHCP" > /dev/null
      container start "$DHCP" > /dev/null
    fi
  else
    ensure_image "$DHCP_IMAGE" dhcp/
    echo "Creating container $DHCP"
    container run -d --name "$DHCP" \
      --cap-add NET_ADMIN \
      --volume ./dhcp:/data \
      "$DHCP_IMAGE" > /dev/null
  fi

  ip=$(container_ip "$DHCP")
  echo "DHCP IP: $ip"

  # Router DHCP relay and client DNS queries → dnsmasq (rdr rules generated
  # by the daemon, written together: waiting for the DNS one is enough)
  write_state dhcp "$ip"

  # Without the LAN interface (cable unplugged, IP not yet assigned) the
  # daemon does not generate the rules: it adds them within 60s of the IP
  # appearing
  if ! ifconfig | grep -qE "^[[:space:]]inet $mac_ip "; then
    echo "No interface with IP $mac_ip: DHCP/DNS rules will be applied when the LAN is connected"
    return 0
  fi
  wait_anchor "$ANCHORS/mitm.dhcp" "-> $ip port 53"
  echo "DHCP/DNS pf rules applied"
}

# Stops dnsmasq and removes the pf rules (relay and DNS). Without DHCP clients
# neither get nor renew the lease and the Mac's DNS does not answer: if the
# Mac stops acting as gateway, put the router back in DHCP server mode.
stop_dhcp() {
  stop_container "$DHCP" "$1"
  write_state dhcp ""
  wait_anchor "$ANCHORS/mitm.dhcp" ""
  echo "DHCP and DNS stopped: clients do not renew the lease and do not resolve names (restore the DHCP server on the router if needed)"
}

# --- mitmproxy --------------------------------------------------------------

# Starts mitmproxy and the pf rules that route to it the HTTP/HTTPS of LAN
# clients and of the Mac to the domains in mac-domains.txt. Starts DHCP
# first, which assigns the Mac as gateway to the clients.
start_proxy() {
  local ip

  start_dhcp

  if ! start_existing "$PROXY"; then
    ensure_image "$PROXY_IMAGE" .
    echo "Creating container $PROXY"
    # ./export: mitmproxy's working directory, files saved by its commands
    # show up here on the Mac. ./edit: files being edited on the Mac
    # (mac-editor.sh). ./mocks: mock definitions and uploaded contents,
    # shared between the addon and the dashboard. ./mockui: the dashboard
    # itself, mounted so it can be changed without rebuilding the image.
    # They must exist, otherwise container run fails.
    mkdir -p export edit mocks
    container run -d --name "$PROXY" \
      --cap-add NET_ADMIN \
      --dns-domain "$DNS_DOMAIN" \
      --volume ./mitmproxy:/root/.mitmproxy \
      --volume ./export:/export \
      --volume ./edit:/edit \
      --volume ./mocks:/mocks \
      --volume ./mockui:/mockui \
      -e "MITM_UI=${MITM_UI:-console}" \
      -e "MITM_WEB_PASSWORD=${MITM_WEB_PASSWORD:-password}" \
      "$PROXY_IMAGE" > /dev/null
  fi

  ip=$(container_ip "$PROXY")
  echo "mitmproxy IP: $ip"

  # Domains of the Mac's traffic to intercept: the daemon resolves them and
  # loads them into the pf table <mitm_local>
  write_state domains "$(cat mac-domains.txt 2> /dev/null)"

  # HTTP/HTTPS of LAN clients, and of the Mac to <mitm_local> → mitmproxy
  # (routed, destination unchanged; route-to rules generated by the daemon,
  # which also finds the bridge to the container). The tag rule is always
  # there, even without LAN or network: waiting for it is enough.
  write_state route "$ip"
  wait_anchor "$ANCHORS/mitm.route" "from $ip to any port"
  echo "mitmproxy pf rule applied"

  if [ "$(proxy_ui)" = web ]; then
    echo "Web UI: http://$PROXY:8081   (./mitm open)"
  else
    echo "Console: ./mitm open   (Ctrl-b d to detach)"
  fi
  echo "Mock dashboard: $MOCK_URL   (./mitm mock; mocks start disabled)"
}

# Stops mitmproxy and removes the route-to rules. DHCP stays up: clients
# keep the Mac as gateway and browse via NAT. Without flushing the rule,
# client HTTP/HTTPS would stay routed to an IP that is no longer
# active.
stop_proxy() {
  stop_container "$PROXY" "$1"
  write_state route ""
  wait_anchor "$ANCHORS/mitm.route" ""
  echo "Interception disabled: LAN clients reach the Internet via the Mac's NAT"
}

# --- status -----------------------------------------------------------------

# "state" and "last exit code" of a launchd job ($1: system/... or gui/...)
launchd_job() {
  local out
  if ! out=$(launchctl print "$1" 2> /dev/null); then
    echo "not installed"
    return 0
  fi
  # Jobs start on events (WatchPaths, login): "not running" is the norm
  awk -F' = ' '
    /^\tstate = / { state = $2 }
    /^\tlast exit code = / { code = $2 }
    END {
      printf "installed, %s", (state == "running" ? "running" : "waiting")
      if (code == "(never exited)" || code == "") print ", never run"
      else if (code == "0") print ", last run ok"
      else print ", LAST RUN FAILED (" code ")"
    }' <<<"$out"
}

# Status line of a rule: "→ IP" or "off"
rule_target() {
  if [ -n "$1" ]; then echo "→ $1"; else echo off; fi
}

# First field of state file $1 (empty if missing)
state_ip() {
  awk 'NR == 1 { print $NF }' "$STATE/$1" 2> /dev/null || true
}

cmd_status() {
  local name state ip want sub warn=() rules n

  echo "Configuration (mitm.conf): LAN_IP=$(conf LAN_IP) ROUTER_IP=$(conf ROUTER_IP)"
  if [ ! -f "$DAEMON_CONF" ]; then
    warn+=("daemon's copy of mitm.conf missing: ./mitm install")
  elif ! daemon_conf_current; then
    warn+=("mitm.conf differs from the daemon's copy: ./mitm install")
  fi
  echo "Network detected by the daemon: $(cat "$ANCHORS/mitm.net" 2> /dev/null || echo -)"
  echo "IP forwarding: $([ "$(sysctl -n net.inet.ip.forwarding)" = 1 ] && echo on || echo OFF)"
  [ "$(sysctl -n net.inet.ip.forwarding)" = 1 ] ||
    warn+=("IP forwarding off: LAN clients cannot get out (sudo sysctl -w net.inet.ip.forwarding=1)")

  echo
  if ! container system status > /dev/null 2>&1; then
    echo "container services: not running (container system start)"
    warn+=("container services not running")
  else
    echo "Containers:"
    for name in "$DHCP" "$PROXY"; do
      state=$(container_state "$name")
      ip=""
      [ "$state" = running ] &&
        ip=$(container inspect "$name" | jq -r '.[0].status.networks[0].ipv4Address // empty' | cut -d/ -f1)
      if [ "$name" = "$PROXY" ] && [ "$state" != absent ]; then
        printf '  %-16s %-9s %-15s %s\n' "$name" "$state" "$ip" "($(proxy_ui))"
      else
        printf '  %-16s %-9s %s\n' "$name" "$state" "$ip"
      fi
      # pf rule consistent with the container
      if [ "$name" = "$DHCP" ]; then
        want=$(state_ip dhcp) sub=" dhcp"
      else
        want=$(state_ip route) sub=""
      fi
      if [ -n "$want" ] && [ "$want" != "$ip" ]; then
        warn+=("pf rule of $name points to $want, but the container ${ip:+has IP $ip}${ip:-is not running}: ./mitm start$sub or ./mitm stop$sub")
      elif [ -z "$want" ] && [ -n "$ip" ]; then
        warn+=("$name running without pf rule: ./mitm start$sub")
      fi
    done
  fi

  echo
  # Mocks: read from the volume, without asking the container. The switch is
  # the existence of mocks/enabled, removed by the dashboard at every start.
  n=$(jq '[.mocks[] | select(.enabled)] | length' mocks/mocks.json 2> /dev/null || echo 0)
  printf 'Mocks: %s (%s active out of %s) — %s\n' \
    "$([ -f mocks/enabled ] && echo "ON: matching requests are not forwarded" || echo "off")" \
    "$n" "$(jq '.mocks | length' mocks/mocks.json 2> /dev/null || echo 0)" "$MOCK_URL"

  echo
  echo "pf rules (com.apple/100.mitm.*):"
  n=$(grep -c . "$ANCHORS/mitm.nat" 2> /dev/null || true)
  printf '  %-11s %s\n' NAT "$([ "${n:-0}" -gt 0 ] && echo "$n rules" || echo missing)"
  rules=$(sed -nE 's/.*port 53 -> ([0-9.]+) port 53/\1/p' "$ANCHORS/mitm.dhcp" 2> /dev/null || true)
  printf '  %-11s %s\n' DHCP/DNS "$(rule_target "$rules")"
  rules=$(sed -nE 's/.*from ([0-9.]+) to any port.*tag MITM_VM.*/\1/p' "$ANCHORS/mitm.route" 2> /dev/null || true)
  printf '  %-11s %s\n' mitmproxy "$(rule_target "$rules")"
  if [ -n "$rules" ]; then
    n=$(grep -c . "$ANCHORS/mitm.local" 2> /dev/null || true)
    printf '  %-11s %s IPs in <mitm_local>, %s domains in mac-domains.txt\n' "Mac domains" "${n:-0}" \
      "$(sed -E 's/#.*//; s/[[:space:]]+//g' mac-domains.txt 2> /dev/null | grep -c . || true)"
  fi

  echo
  state=$(launchd_job system/com.mitm.pf)
  echo "Daemon com.mitm.pf: $state"
  case "$state" in
    *FAILED* | "not installed") warn+=("daemon com.mitm.pf: see $PF_LOG, reinstall with ./mitm install") ;;
  esac
  for name in dhcp domains; do
    state=$(launchd_job "gui/$(id -u)/com.mitm.$name")
    echo "LaunchAgent com.mitm.$name: $state"
    case "$state" in
      *FAILED*) warn+=("LaunchAgent com.mitm.$name: see ~/Library/Logs/mitm-$name.log") ;;
    esac
  done

  if [ ${#warn[@]} -gt 0 ]; then
    echo
    printf 'Warning: %s\n' "${warn[@]}"
  fi
}

# --- installation -----------------------------------------------------------

# One-off installation, idempotent: rerun after changing mitm.conf or the
# daemon. A single sudo for the root part.
cmd_install() {
  local cmd

  [ "$(id -u)" -ne 0 ] || die "Run as a normal user, without sudo (the command asks for sudo when needed)"
  for cmd in container jq; do
    command -v "$cmd" > /dev/null ||
      die "$cmd not found: container from https://github.com/apple/container/releases, jq with brew install jq"
  done
  load_conf

  echo "== container services"
  container system start

  echo "== Root part (sudo): pf daemon, copy of mitm.conf, IP forwarding, .$DNS_DOMAIN domain"
  sudo ./daemon/install.sh

  echo "== Images"
  ensure_image "$DHCP_IMAGE" dhcp/
  ensure_image "$PROXY_IMAGE" .

  # The agents start immediately: com.mitm.dhcp starts DHCP (and restarts
  # dnsmasq if the LAN configuration changed)
  echo "== LaunchAgent"
  ./launchagent/install.sh

  echo
  echo "Installation complete. To do by hand, if not done already:"
  ifconfig | grep -qE "^[[:space:]]inet $MAC_IP " ||
    echo "  - static IP $MAC_IP/$PREFIX on the interface connected to the LAN (no interface has it now)"
  echo "  - router $ROUTER_IP: DHCP in relay mode to $MAC_IP, no other DHCP on the LAN"
  [ -f mitmproxy/mitmproxy-ca.pem ] ||
    echo "  - CA: on first start mitmproxy generates a new one; to reuse one already installed on the devices, copy it into mitmproxy/ first"
  echo "Then: ./mitm start, and ./mitm status to check"
}

# Removes agents, daemon and pf rules. Containers, images and project
# configuration are kept.
cmd_uninstall() {
  [ "$(id -u)" -ne 0 ] || die "Run as a normal user, without sudo"
  # Before removing the daemon: it is the one that flushes the rules
  if [ -d "$STATE" ] && container system status > /dev/null 2>&1; then
    cmd_stop all
  fi
  ./launchagent/install.sh --remove
  sudo ./daemon/install.sh --remove
  echo "Containers and images are kept: ./mitm stop all --rm, then container image rm $PROXY_IMAGE $DHCP_IMAGE"
}

# --- commands ---------------------------------------------------------------

cmd_stop() {
  local target=proxy rm=false arg
  for arg in "$@"; do
    case "$arg" in
      --rm) rm=true ;;
      proxy | dhcp | all) target=$arg ;;
      *) usage >&2; exit 1 ;;
    esac
  done
  case "$target" in
    proxy) stop_proxy "$rm" ;;
    dhcp) stop_dhcp "$rm" ;;
    all) stop_proxy "$rm"; stop_dhcp "$rm" ;;
  esac
}

# Opens on the Mac the files that the console edits (mac-editor.sh in the
# container writes edit/<file> and the request edit/<file>.open with the
# mode, edit or view). Editing: application MITM_EDITOR, default the
# system's default text editor; viewing (key v): default application for
# the type. The rename claims the request (only one of several attached
# terminals opens it); open errors go back to the container in
# edit/<file>.error.
# The same channel carries the mock dashboard (mode url, key M): there the
# file holds a URL instead of the content to edit, and it is checked against
# the dashboard's own address — it arrives from the container, so it is not
# handed to open as it is.
edit_watcher() {
  local req file mode out url
  while sleep 0.5; do
    for req in edit/*.open; do
      mv "$req" "$req.$$" 2> /dev/null || continue
      file=${req%.open}
      mode=$(cat "$req.$$" 2> /dev/null || true)
      rm -f "$req.$$"
      if [ "$mode" = url ]; then
        url=$(cat "$file" 2> /dev/null || true)
        rm -f "$file"
        case $url in
          "$MOCK_URL"*) out=$(/usr/bin/open "$url" 2>&1) ;;
          *) out="unexpected URL: $url"; false ;;
        esac
      elif [ "$mode" = view ]; then
        out=$(/usr/bin/open "$file" 2>&1) || out=$(/usr/bin/open -t "$file" 2>&1)
      elif [ -n "${MITM_EDITOR:-}" ]; then
        out=$(/usr/bin/open -a "$MITM_EDITOR" "$file" 2>&1)
      else
        out=$(/usr/bin/open -t "$file" 2>&1)
      fi || printf '%s\n' "$out" > "$file.error"
    done
  done
}

# mitmproxy console (tmux) in this terminal, with edit_watcher in the
# background while attached (silent: it would write over the console)
attach_console() {
  mkdir -p edit
  edit_watcher > /dev/null 2>&1 &
  trap "kill $! 2> /dev/null" EXIT
  container exec -it "$PROXY" tmux attach -t mitm
}

cmd_attach() {
  [ "$(container_state "$PROXY")" = running ] || die "mitmproxy is not running: ./mitm start"
  if [ "$(proxy_ui)" = web ]; then
    echo "Web UI: http://$PROXY:8081"
  else
    attach_console
  fi
}

# Opens the mitmproxy interface: the web UI in the default browser, or the
# console in this terminal. The password is not put in the URL (it would end
# up in the browser history): mitmweb asks for it on the login page.
cmd_open() {
  [ "$(container_state "$PROXY")" = running ] || die "mitmproxy is not running: ./mitm start"
  if [ "$(proxy_ui)" = web ]; then
    /usr/bin/open "http://$PROXY:8081/"
  else
    attach_console
  fi
}

# Mock dashboard: always reachable while the container is running, whatever
# MITM_UI is. The mocks themselves start disabled at every start: the switch
# is in the dashboard.
cmd_mock() {
  [ "$(container_state "$PROXY")" = running ] || die "mitmproxy is not running: ./mitm start"
  /usr/bin/open "$MOCK_URL"
}

cmd_logs() {
  local target=proxy follow=() arg
  for arg in "$@"; do
    case "$arg" in
      -f) follow=(-f) ;;
      proxy | dhcp | pf) target=$arg ;;
      *) usage >&2; exit 1 ;;
    esac
  done
  case "$target" in
    pf) exec tail -n 50 ${follow[@]+"${follow[@]}"} "$PF_LOG" ;;
    dhcp) exec container logs ${follow[@]+"${follow[@]}"} "$DHCP" ;;
    proxy)
      # In console mode mitmproxy's output is in the tmux session, not in the logs
      [ "$(proxy_ui)" = console ] && echo "(console: mitmproxy events in ./mitm attach, key E)" >&2
      exec container logs ${follow[@]+"${follow[@]}"} "$PROXY"
      ;;
  esac
}

cmd_build() {
  case "${1:-all}" in
    proxy) container build -t "$PROXY_IMAGE" . ;;
    dhcp) container build -t "$DHCP_IMAGE" dhcp/ ;;
    all)
      container build -t "$PROXY_IMAGE" .
      container build -t "$DHCP_IMAGE" dhcp/
      ;;
    *) usage >&2; exit 1 ;;
  esac
  echo "To use the new image: ./mitm stop all --rm && ./mitm start"
}

case "${1:-}" in
  start)
    case "${2:-proxy}" in
      proxy) start_proxy ;;
      dhcp) start_dhcp ;;
      *) usage >&2; exit 1 ;;
    esac
    ;;
  stop) shift; cmd_stop "$@" ;;
  status) cmd_status ;;
  attach) cmd_attach ;;
  open) cmd_open ;;
  mock) cmd_mock ;;
  logs) shift; cmd_logs "$@" ;;
  build) shift; cmd_build "$@" ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 1 ;;
esac
