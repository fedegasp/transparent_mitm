#!/bin/bash
# Run as root by the LaunchDaemon com.mitm.pf (installed in
# /usr/local/libexec). Reads the IPs written by the user scripts in
# /usr/local/var/mitm-pf/ and regenerates the pf anchors. The state files are
# writable by the user: their content is validated, never executed.
#
# The anchors are children of com.apple (com.apple/100.mitm.*), already reached
# by the nat-anchor, rdr-anchor and anchor "com.apple/*" lines of the system
# /etc/pf.conf: nothing to change in /etc/pf.conf. Children are evaluated in
# name order, so 100.* comes before 200.AirDrop and 250.ApplicationFirewall,
# and com.apple/* comes before the com.apple.internet-sharing anchors.
# Since they are not loaded by /etc/pf.conf, they are empty at boot: this
# script loads them (RunAtLoad).
#
#   route    →  "<mitmproxy IP>"   (empty/missing = no interception)
#   dhcp     →  "<dnsmasq IP>"     (empty/missing = no DHCP/DNS)
#   domains  →  one domain per line: Mac traffic to intercept
#
# Files older than the last boot are ignored: after a reboot the containers
# are stopped and the rules of the previous session must be flushed.
#
# LAN configuration in /usr/local/etc/mitm.conf (root copy of the project's
# mitm.conf, installed by install.sh). Derived on every run, so the rules
# follow network changes:
#   WAN     interface of the default route (en0 WiFi, Ethernet, ...)
#   LAN_IF  interface holding the Mac's LAN_IP (missing: no LAN rules)
#   BRIDGE  interface towards the containers (vmnet bridge), and its subnet
#
# Also run every 60s (StartInterval) and on every change of the system DNS
# (WatchPaths): re-resolves the domains and updates the <mitm_local> table
# (CDN IPs change), and regenerates the rules if the network has changed.
set -u

CONF=/usr/local/etc/mitm.conf
STATE=/usr/local/var/mitm-pf
ANCHORS=/etc/pf.anchors     # generated rule files, mitm.*
PARENT=com.apple
IP_RE='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
IP6_RE='^[0-9a-fA-F:]{2,39}$'
CIDR_RE='^([0-9]{1,3}\.){3}[0-9]{1,3}/([89]|[12][0-9]|30)$'
IF_RE='^[a-z]{2,8}[0-9]{1,3}$'
BRIDGE_RE='^bridge[0-9]{1,3}$'
DOMAIN_RE='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
MAX_DOMAINS=64

log() { echo "$(date '+%F %T') $*"; }

# "{ sec = 1790839610, usec = 680084 } ..." → 1790839610
BOOT=$(sysctl -n kern.boottime | sed -E 's/^\{ sec = ([0-9]+),.*/\1/')

# Content of the state file, empty if missing or older than the boot
read_state() {
  local f="$STATE/$1"
  [ -f "$f" ] || return 0
  [ "$(stat -f %m "$f")" -ge "$BOOT" ] || return 0
  head -c 64 "$f" | head -n 1
}

# Value of KEY=value in $CONF (quotes stripped), never executed
conf() {
  [ -f "$CONF" ] || return 0
  sed -nE "s/^$1=[\"']?([^\"'#[:space:]]*).*/\1/p" "$CONF" | tail -n 1
}

ip2int() {
  local IFS=. a b c d
  read -r a b c d <<<"$1"
  echo $(((a << 24) | (b << 16) | (c << 8) | d))
}

int2ip() {
  echo "$((($1 >> 24) & 255)).$((($1 >> 16) & 255)).$((($1 >> 8) & 255)).$(($1 & 255))"
}

# "192.168.3.2/24" → "192.168.3.0/24"
network() {
  local mask=$(((0xffffffff << (32 - ${1#*/})) & 0xffffffff))
  echo "$(int2ip $(($(ip2int "${1%/*}") & mask)))/${1#*/}"
}

# Interface holding the IPv4 address $1
iface_with_ip() {
  ifconfig | awk -v ip="$1" '
    /^[a-z0-9]+:/ { i = substr($1, 1, length($1) - 1) }
    $1 == "inet" && $2 == ip { print i; exit }'
}

# Subnet of interface $1: "inet 192.168.64.1 netmask 0xffffff00" → 192.168.64.0/24
iface_net() {
  local ip mask bits=0
  read -r ip mask <<<"$(ifconfig "$1" 2> /dev/null | awk '$1 == "inet" { print $2, $4; exit }')"
  [[ $ip =~ $IP_RE ]] && [[ $mask =~ ^0x[0-9a-f]{8}$ ]] || return 0
  mask=$((mask))
  while [ $((mask & 0x80000000)) -ne 0 ]; do
    bits=$((bits + 1))
    mask=$(((mask << 1) & 0xffffffff))
  done
  network "$ip/$bits"
}

# Interface used to reach $1 (default route with "default")
route_iface() {
  route -n get "$1" 2> /dev/null | awk '$1 == "interface:" { print $2 }'
}

# Loads the rules $2 into the anchor $PARENT/100.$1 (file $ANCHORS/$1), or
# flushes it if $2 is empty ($3: type to flush, rules or nat). Does nothing if
# the rules are unchanged and already loaded (at boot the file exists but the
# anchor is empty). Returns 0 if the anchor changed.
apply_anchor() {
  local file="$ANCHORS/$1" anchor="$PARENT/100.$1" new="$2" show=-sr
  [ "$3" = nat ] && show=-sn
  if [ -f "$file" ] && [ "$(cat "$file")" = "$new" ]; then
    [ -z "$new" ] && return 1
    pfctl -a "$anchor" "$show" 2> /dev/null | grep -q . && return 1
  fi
  printf '%s' "$new" > "$file"
  [ -n "$new" ] && printf '\n' >> "$file"
  if [ -n "$new" ]; then
    pfctl -a "$anchor" -f "$file"
  else
    pfctl -a "$anchor" -F "$3"
  fi
  return 0
}

# Domains chosen for the Mac, validated, one per line
domain_list() {
  local f="$STATE/domains"
  [ -f "$f" ] || return 0
  head -c 4096 "$f" | sed -E 's/#.*//; s/[[:space:]]+//g' | tr 'A-Z' 'a-z' |
    grep -E "$DOMAIN_RE" | head -n "$MAX_DOMAINS"
}

# "<IP> <domain>" (v4 and v6) of the domains in $1, one per line. Resolved
# with the system resolver, the same one (and the same cache) as the browsers.
resolve_domains() {
  local d
  for d in $1; do
    dscacheutil -q host -a name "$d" |
      awk -v d="$d" '$1 == "ip_address:" || $1 == "ipv6_address:" { print $2, d }'
  done | while read -r ip d; do
    if [[ $ip =~ $IP_RE || $ip =~ $IP6_RE ]]; then echo "$ip $d"; fi
  done
}

# --- Configuration and current network ---
LAN_IP=$(conf LAN_IP)          # Mac's IP on the LAN, with prefix: 192.168.3.2/24
ROUTER_IP=$(conf ROUTER_IP)    # LAN router (DHCP relay)
LAN_IF="" LAN_NET="" MAC_LAN_IP=""
if [[ $LAN_IP =~ $CIDR_RE ]] && [[ $ROUTER_IP =~ $IP_RE ]]; then
  MAC_LAN_IP=${LAN_IP%/*}
  LAN_NET=$(network "$LAN_IP")
  LAN_IF=$(iface_with_ip "$MAC_LAN_IP")
  [[ $LAN_IF =~ $IF_RE ]] || LAN_IF=""
else
  log "configuration $CONF missing or invalid (LAN_IP, ROUTER_IP): no LAN rules"
fi

WAN=$(route_iface default)
[[ $WAN =~ $IF_RE ]] && [ "$WAN" != "$LAN_IF" ] || WAN=""

read -r MITM_IP _ <<<"$(read_state route)"
read -r DHCP_IP _ <<<"$(read_state dhcp)"
[[ ${MITM_IP:-} =~ $IP_RE ]] || MITM_IP=""
[[ ${DHCP_IP:-} =~ $IP_RE ]] || DHCP_IP=""

# vmnet bridge: interface towards a running container, and its subnet
BRIDGE="" VM_NET=""
for ip in $MITM_IP $DHCP_IP; do
  BRIDGE=$(route_iface "$ip")
  [[ $BRIDGE =~ $BRIDGE_RE ]] && break
  BRIDGE=""
done
[ -n "$BRIDGE" ] && VM_NET=$(iface_net "$BRIDGE")

# Detected network, logged only when it changes. In $ANCHORS (owned by root),
# not in the state directory: that is writable by the user, and a write there
# would trigger the daemon again (WatchPaths).
NET_INFO="WAN=${WAN:--} LAN=${LAN_IF:--} ${LAN_NET:-} bridge=${BRIDGE:--} ${VM_NET:-}"
NET_FILE="$ANCHORS/mitm.net"
if [ "$(cat "$NET_FILE" 2> /dev/null)" != "$NET_INFO" ]; then
  log "network: $NET_INFO"
  printf '%s\n' "$NET_INFO" > "$NET_FILE"
fi

# --- NAT to the Internet: LAN clients (non-intercepted traffic) and container
# egress. Container NAT is also done by InternetSharing with its own anchors in
# the main ruleset, which a full reload of /etc/pf.conf removes: with this
# rule the egress does not depend on them.
RULE=""
if [ -n "$WAN" ]; then
  [ -n "$LAN_NET" ] && RULE="nat on $WAN inet from $LAN_NET to any -> ($WAN)"
  [ -n "$VM_NET" ] && RULE="${RULE:+$RULE
}nat on $WAN inet from $VM_NET to any -> ($WAN)"
fi
apply_anchor mitm.nat "$RULE" nat

# --- mitmproxy: route-to of LAN clients and of Mac traffic to <mitm_local> ---
#
# Mac traffic: outbound route-to on $WAN, without translation (same reason as
# the LAN: SO_ORIGINAL_DST in the container). mitmproxy's connections to the
# Internet also leave through $WAN with source ($WAN) after NAT: they are
# tagged MITM_VM when entering from $BRIDGE and excluded from the route-to,
# otherwise they would go back to the container (loop). The tag is "sticky":
# no quick on the rule that applies it, so it does not override the later
# rules on $BRIDGE (com.apple/2xx.*, com.apple.internet-sharing).
# IPv6 (not handled by the container) and QUIC to <mitm_local> are rejected
# with RST/ICMP: the browser falls back at once to TCP IPv4, which is
# intercepted.
RULE=""
if [ -n "$MITM_IP" ] && [ -n "$BRIDGE" ]; then
  RULE="table <mitm_local> persist"
  [ -n "$LAN_IF" ] && RULE="$RULE
pass in quick on $LAN_IF route-to ($BRIDGE $MITM_IP) inet proto tcp from $LAN_NET to any port { 80, 443 } keep state"
  RULE="$RULE
pass in on $BRIDGE inet proto tcp from $MITM_IP to any port { 80, 443 } tag MITM_VM keep state"
  [ -n "$WAN" ] && RULE="$RULE
pass out quick on $WAN route-to ($BRIDGE $MITM_IP) inet proto tcp from ($WAN) to <mitm_local> port { 80, 443 } ! tagged MITM_VM keep state
block return out quick on $WAN inet6 proto tcp from any to <mitm_local> port { 80, 443 }
block return out quick on $WAN proto udp from any to <mitm_local> port 443"
fi
ROUTE=$PARENT/100.mitm.route
FORCE_TABLE=false
# Domain IPs before a possible reload, to kill their states
OLD_IPS=$(pfctl -q -a "$ROUTE" -t mitm_local -T show 2> /dev/null)
if apply_anchor mitm.route "$RULE" rules; then
  [ -z "$RULE" ] && pfctl -q -a "$ROUTE" -t mitm_local -T kill 2> /dev/null
  # Client and Mac connections still bound to the previous rule
  [ -n "$LAN_NET" ] && pfctl -k "$LAN_NET"
  for ip in $OLD_IPS; do
    if [[ $ip == *:* ]]; then any=::/0; else any=0.0.0.0/0; fi
    pfctl -q -k "$any" -k "$ip"
  done
  # Reloading the anchor empties the table
  FORCE_TABLE=true
fi

# <mitm_local> table: IPs resolved in the last $KEEP seconds. CDNs rotate IPs
# at every TTL expiry (CloudFront: 60s): the browser may use an IP obtained
# before the last resolution. Updated only if the IPs change.
# Expired IPs do not kill states: open connections stay intercepted. The IPs
# of a domain removed from the list leave the table at once, and their states
# are killed.
TABLE_FILE="$ANCHORS/mitm.local"
SEEN_FILE="$ANCHORS/mitm.local.seen"   # "<epoch> <IP> <domain>"
KEEP=900
if [ -n "$RULE" ]; then
  NOW=$(date +%s)
  DOMAINS=$(domain_list)
  RECENT=""
  [ -f "$SEEN_FILE" ] && RECENT=$(awk -v min=$((NOW - KEEP)) '$1 >= min' "$SEEN_FILE")
  {
    # Lines of domains still in the list (lines without a domain, in the old
    # format, are dropped)
    # (the list as a file: macOS awk does not accept newlines in -v)
    awk 'FILENAME == ARGV[1] { ok[$1] = 1; next } NF == 3 && ($3 in ok)' \
      <(printf '%s\n' "$DOMAINS") <(printf '%s\n' "$RECENT")
    resolve_domains "$DOMAINS" | sed "s/^/$NOW /"
  } | sort -k2,2 -k3,3 -k1,1nr | awk '!seen[$2 " " $3]++' > "$SEEN_FILE.tmp"
  mv "$SEEN_FILE.tmp" "$SEEN_FILE"
  IPS=$(awk '!seen[$2]++ { print $2 }' "$SEEN_FILE")
  if [ "$FORCE_TABLE" = true ] || [ ! -f "$TABLE_FILE" ] || [ "$(cat "$TABLE_FILE")" != "$IPS" ]; then
    printf '%s' "$IPS" > "$TABLE_FILE"
    [ -n "$IPS" ] && printf '\n' >> "$TABLE_FILE"
    pfctl -q -a "$ROUTE" -t mitm_local -T replace -f "$TABLE_FILE"
    log "mitm_local: $(grep -c . "$TABLE_FILE") IP"
  fi
  # IPs not expired but removed with their domain: kill open connections
  for ip in $(comm -23 <(awk 'NF == 3 { print $2 }' <<<"$RECENT" | sort -u) <(sort -u <<<"$IPS")); do
    if [[ $ip == *:* ]]; then any=::/0; else any=0.0.0.0/0; fi
    pfctl -q -k "$any" -k "$ip"
  done
else
  rm -f "$TABLE_FILE" "$SEEN_FILE"
fi

# --- DHCP and DNS (dnsmasq): rdr of the relay and of the clients' DNS queries ---
RULE=""
if [ -n "$DHCP_IP" ] && [ -n "$LAN_IF" ]; then
  RULE="rdr on $LAN_IF inet proto udp from $ROUTER_IP to $MAC_LAN_IP port 67 -> $DHCP_IP port 67
rdr on $LAN_IF inet proto { udp, tcp } from $LAN_NET to $MAC_LAN_IP port 53 -> $DHCP_IP port 53"
fi
if apply_anchor mitm.dhcp "$RULE" nat; then
  # Relay and DNS queries to the Mac (the router is inside the LAN)
  [ -n "$LAN_NET" ] && pfctl -k "$LAN_NET" -k "$MAC_LAN_IP"
fi
pfctl -s info | grep -q 'Status: Enabled' || pfctl -E
exit 0
