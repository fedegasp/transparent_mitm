<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mitm.pf</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/mitm-pf-apply</string>
    </array>
    <!-- At boot: flushes the rules of the previous session -->
    <key>RunAtLoad</key>
    <true/>
    <!-- On every change of the state files written by the user scripts, and
         of the system DNS (network change: the rules follow the new WAN) -->
    <key>WatchPaths</key>
    <array>
        <string>/usr/local/var/mitm-pf</string>
        <string>/var/run/resolv.conf</string>
    </array>
    <!-- Re-resolves the Mac domains (mitm_local table): CDN IPs change.
         Also detects network changes without a DNS change -->
    <key>StartInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>/var/log/mitm-pf.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/mitm-pf.log</string>
</dict>
</plist>
